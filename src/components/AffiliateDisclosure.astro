---
/**
 * AffiliateDisclosure.astro — Compact disclosure box for top of review pages.
 * Appears below AuthorByline, above QuickPick.
 * `tested={false}` for pages built from third-party testing rather than ours —
 * the default sentence is a first-hand claim and must not run on those.
 */
interface Props { tested?: boolean }
const { tested } = Astro.props;
---

<div class="afd" role="note" aria-label="Affiliate disclosure">
  <p class="afd__text">
    ℹ️ <strong>Disclosure:</strong> We earn a small commission (typically 3-4%)
    if you buy through our links. This never influences our rankings — {tested === false
      ? <>the measurements on this page come from the <a href="/how-we-test/">outlets we credit</a>, not from us.</>
      : <>every product was <a href="/how-we-test/">independently purchased and tested</a>.</>}
  </p>
</div>

<style>
.afd {
  margin: 0 0 20px;
  padding: 10px 16px;
  background: #FFFBEB;
  border-left: 3px solid #F59E0B;
  border-radius: 0 var(--r1) var(--r1) 0;
}

.afd__text {
  font-size: 16px;
  color: #7C6E3B;
  line-height: 1.5;
  margin: 0;
}
.afd__text strong {
  color: #5C4F24;
}
.afd__text a {
  color: #5C4F24;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.afd__text a:hover {
  color: var(--green, #1E3A28);
}
</style>
