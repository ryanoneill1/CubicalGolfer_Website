---
/**
 * AffiliateCTA.astro
 * Prominent "Buy Now" / "Check Price" CTA block.
 */

interface Props {
  /** program: 'direct' — earns nothing, so no rel=sponsored and no "Check price" wording. */
  unmonetised?: boolean;
  url: string;
  price: string;
  name: string;
  retailer: string;
  label?: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'secondary' | 'urgent';
  disclosure?: boolean;
  dateChecked?: string;
  isWinner?: boolean;
  golfGalaxyUrl?: string;
  golfGalaxyLabel?: string;
  primaryRetailer?: 'direct' | 'amazon';
}

const {
  url,
  price,
  name,
  retailer,
  label,
  size = 'md',
  variant = 'primary',
  disclosure = false,
  dateChecked = '',
  isWinner = false,
  golfGalaxyUrl = '',
  golfGalaxyLabel = '',
  primaryRetailer,
  unmonetised = false,
} = Astro.props;

// When primaryRetailer is 'direct' and a partner URL exists, swap the buttons:
// the partner link becomes the big primary button, Amazon becomes secondary.
// golfGalaxyLabel marks a secondary link that is a DIFFERENT product (e.g. a newer
// generation the partner stocks instead). Swapping it into the primary slot would
// sell the wrong item, so an explicitly-labelled alternate is never promoted.
const isAltProduct = Boolean(golfGalaxyLabel);
const shouldSwap = !isAltProduct && primaryRetailer === 'direct' && golfGalaxyUrl && !url.includes('playbetter.com') && !url.includes('bushnell.pxf.io') && url.includes('amazon.com');
const primaryUrl = shouldSwap ? golfGalaxyUrl : url;
const secondaryUrl = shouldSwap ? url : golfGalaxyUrl;

const primaryRetailerName = shouldSwap
  ? (golfGalaxyUrl.includes('playbetter.com') ? 'PlayBetter'
    : golfGalaxyUrl.includes('golfgalaxy') || golfGalaxyUrl.includes('click-101736949') ? 'Golf Galaxy'
    : golfGalaxyUrl.includes('bushnell.pxf.io') ? 'Bushnell'
    : 'Retailer')
  : retailer;

// An unmonetised entry links to the maker, not a storefront with a live price,
// so it uses its own label ("Find a Dealer →") instead of promising a price check.
const btnText = unmonetised
  ? `${price} — ${label}`
  : `${price} at ${primaryRetailerName} — Check Today's Price →`;
// FIX: Urgency-focused meta line — "Prices checked today" converts better than a static date
// 'Free shipping' is an Amazon promise. Entries that link straight to the maker
// (program: 'direct' → unmonetised) are free apps or dealer-sold vehicles, where
// neither shipping nor a live price is ours to promise.
const dateLabel = unmonetised
  ? `Sold direct by ${primaryRetailerName}`
  : dateChecked
  ? `Free shipping · Prices checked today`
  : `Free shipping · Prices may vary`;
---

<div class:list={['aff-cta', `aff-cta--${size}`, `aff-cta--${variant}`]}>
  {isWinner && (
    <span class="aff-cta__winner-badge">💰 Lowest price we've seen</span>
  )}
  <a
    href={primaryUrl}
    class="aff-cta__btn"
    data-outbound={primaryUrl.includes("amazon.com") ? "amazon" : primaryUrl.includes("bushnell") ? "bushnell" : primaryUrl.includes("playbetter") ? "playbetter" : primaryUrl.includes("golfgalaxy") || primaryUrl.includes("click-101736949") ? "golfgalaxy" : "other"}
    target="_blank"
    rel={unmonetised ? "nofollow noopener" : "nofollow noopener sponsored"}
    aria-label={unmonetised ? `Get ${name} from ${primaryRetailerName}` : `Check price for ${name} at ${primaryRetailerName}`}
    onclick={`window.plausible&&window.plausible('Affiliate Click',{props:{product:'${name.replace(/'/g,"\\'")}',retailer:'${primaryRetailerName}'}});`}
  >
    <span class="aff-cta__btn-text">{btnText}</span>
  </a>
  {secondaryUrl && (() => {
    const secondaryRetailer = secondaryUrl.includes('amazon.com') ? 'Amazon'
      : secondaryUrl.includes('playbetter.com') ? 'PlayBetter'
      : secondaryUrl.includes('golfgalaxy') || secondaryUrl.includes('click-101736949') ? 'Golf Galaxy'
      : 'Retailer';
    return (
    <a
      href={secondaryUrl}
      class="aff-cta__btn aff-cta__btn--gg"
      data-outbound={secondaryUrl.includes("amazon.com") ? "amazon" : secondaryUrl.includes("bushnell") ? "bushnell" : secondaryUrl.includes("playbetter") ? "playbetter" : secondaryUrl.includes("golfgalaxy") || secondaryUrl.includes("click-101736949") ? "golfgalaxy" : "other"}
      target="_blank"
      rel={unmonetised ? "nofollow noopener" : "nofollow noopener sponsored"}
      aria-label={unmonetised ? `Get ${name} from ${secondaryRetailer}` : `Check price for ${name} at ${secondaryRetailer}`}
      onclick={`window.plausible&&window.plausible('Affiliate Click',{props:{product:'${name.replace(/'/g,"\\'")}',retailer:'${secondaryRetailer}'}});`}
    >
      <span class="aff-cta__btn-text">{(golfGalaxyLabel && secondaryUrl === golfGalaxyUrl) ? golfGalaxyLabel : `Check Price at ${secondaryRetailer} →`}</span>
    </a>
    );
  })()}
  <p class="aff-cta__meta">{dateLabel}</p>
  {disclosure && (
    <p class="aff-cta__disclosure">
      ⚖️ <em>Affiliate link — we earn a small commission at no extra cost to you.</em>
    </p>
  )}
</div>

<style>
.aff-cta {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin: 20px 0;
  max-width: var(--prose-w, 720px);
}
.aff-cta__winner-badge {
  display: inline-block;
  align-self: flex-start;
  background: #f0f7f2;
  color: var(--green, #1E3A28);
  font-size: 16px;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 20px;
  border: 1px solid #b8dfc5;
  margin-bottom: 2px;
}

/* Button */
.aff-cta__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16px 32px;
  border-radius: 10px;
  text-decoration: none;
  font-weight: 800;
  min-width: 220px;
  text-align: center;
  transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
}
.aff-cta__btn:hover {
  transform: scale(1.02);
  box-shadow: 0 6px 20px rgba(0,0,0,.15);
}
.aff-cta__btn--gg {
  background: #fff !important;
  color: #1E3A28 !important;
  border: 2px solid #1E3A28;
  padding: 12px 28px;
}
.aff-cta__btn--gg:hover {
  background: #f0f7f2 !important;
}
.aff-cta__btn--gg .aff-cta__btn-text { font-size: 16px; font-weight: 700; }
.aff-cta__btn-text { font-size: 16px; font-weight: 800; line-height: 1.3; }

/* Meta line */
.aff-cta__meta {
  font-size: 16px;
  color: var(--muted, #556B5C);
  margin: 0;
  font-weight: 500;
}

/* Variants */
.aff-cta--primary .aff-cta__btn {
  background: var(--green, #1E3A28);
  color: #fff;
}
.aff-cta--primary .aff-cta__btn:hover { background: #1a5c35; }

.aff-cta--secondary .aff-cta__btn {
  background: var(--green, #1E3A28);
  color: #fff;
}
.aff-cta--secondary .aff-cta__btn:hover { background: #152c1e; }

.aff-cta--urgent .aff-cta__btn {
  background: #d63b2f;
  color: #fff;
}
.aff-cta--urgent .aff-cta__btn:hover { background: #b32d22; }

/* Sizes */
.aff-cta--sm .aff-cta__btn      { padding: 12px 22px; min-width: 180px; }
.aff-cta--sm .aff-cta__btn-text { font-size: 16px; }

.aff-cta--lg .aff-cta__btn      { padding: 20px 40px; min-width: 260px; }
.aff-cta--lg .aff-cta__btn-text { font-size: 17px; }

/* Disclosure */
.aff-cta__disclosure {
  font-size: 16px;
  color: var(--muted, #888);
  margin: 0;
}

@media (max-width: 480px) {
  .aff-cta__btn { width: 100%; padding: 16px 20px; }
}
</style>
