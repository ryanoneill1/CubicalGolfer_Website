---
/**
 * ProductCTA.astro — "Quick Pick" above-the-fold affiliate CTA.
 * Highest-converting element on affiliate review sites.
 * Renders after the intro paragraph, before the first H2.
 *
 * All new props (imageUrl, why, bestFor) are optional —
 * existing pages that don't pass them still render correctly.
 */

interface Props {
  /** program: 'direct' — earns nothing, so no rel=sponsored and no "Check price" wording. */
  unmonetised?: boolean;
  productName: string;
  amazonUrl: string;
  amazonPrice: string;
  altUrl?: string;
  altLabel?: string;
  rating?: number;
  badge?: string;
  imageUrl?: string;
  why?: string;
  bestFor?: string;
  /** Registry retailer name. The button used to say "Amazon" unconditionally,
   *  which mislabelled 31 pages that link to Bushnell, PlayBetter or CJ. */
  retailer?: string;
  /** false when the page is built from third-party testing rather than ours. */
  tested?: boolean;
}

const {
  productName,
  amazonUrl,
  amazonPrice,
  altUrl,
  altLabel,
  rating,
  badge,
  imageUrl,
  why,
  bestFor,
  retailer,
  tested,
  unmonetised = false,
} = Astro.props;

/** Name the retailer the link actually goes to, or stay neutral. */
const ctaText = retailer ? `Check Price at ${retailer} \u2192` : `Check Price \u2192`;

const fullStars = rating ? Math.floor(rating) : 0;
const halfStar = rating ? (rating % 1 >= 0.5) : false;
const emptyStars = rating ? (5 - fullStars - (halfStar ? 1 : 0)) : 0;
---

<aside class="qp" role="complementary" aria-label={`Top pick: ${productName}`}>
  <div class="qp__inner">
    {imageUrl && (
      <div class="qp__img-wrap">
        <img src={imageUrl} alt={productName} width="80" height="80" loading="eager" decoding="async" />
      </div>
    )}
    <div class="qp__content">
      {badge && <span class="qp__badge">{badge}</span>}
      <p class="qp__name">{productName}</p>
      {rating && (
        <div class="qp__stars" aria-label={`${rating} out of 5 stars`}>
          {'★'.repeat(fullStars)}{halfStar ? '½' : ''}{'☆'.repeat(emptyStars)}
          <span class="qp__stars-num">{rating.toFixed(1)}</span>
        </div>
      )}
      {bestFor && <p class="qp__best-for">Best for: {bestFor}</p>}
      {why && <p class="qp__why">{why}</p>}
    </div>
    <div class="qp__actions">
      <a
        href={amazonUrl}
        class="qp__cta"
        target="_blank"
        rel={unmonetised ? "nofollow noopener" : "nofollow noopener sponsored"}
        aria-label={`Check price for ${productName}`}
      >
        {amazonPrice && <span class="qp__cta-price">{amazonPrice}</span>}
        <span class="qp__cta-text">{ctaText}</span>
      </a>
      {altUrl && altLabel && (
        <a
          href={altUrl}
          class="qp__alt"
          target="_blank"
          rel={unmonetised ? "nofollow noopener" : "nofollow noopener sponsored"}
        >
          See at {altLabel} →
        </a>
      )}
    </div>
  </div>
  {/* Sprint 178 (F5) — removed. Measured document order on a buying guide:
      early-disclosure @6,093 → FIRST affiliate link @9,264 → this one.
      It restated a promise the reader had already been given 4,000
      characters earlier. Sitewide the four trust promises ran to 4,446 /
      1,974 / 1,919 / 905 repetitions in 411 wordings. Stanford web
      credibility #9 is 'use restraint with promotional content'.
      What remains: <EarlyDisclosure> above the first affiliate link on
      every page, and the footer line. Both verified present on all 238
      affiliate pages by validate-cta-geometry. */}
</aside>

<style>
.qp {
  margin: 20px 0 28px;
  border-left: 4px solid var(--green-mid, #264D33);
  border-radius: var(--r2);
  background: linear-gradient(135deg, #f0f7f2 0%, var(--cream, #F4F1EA) 100%);
  box-shadow: var(--s1);
  overflow: hidden;
}

.qp__inner {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  padding: 24px 24px 16px;
  flex-wrap: wrap;
}

/* ── Product image ─────────────────────────────────────────── */
.qp__img-wrap {
  flex-shrink: 0;
  width: 80px;
  height: 80px;
  border-radius: var(--r1);
  overflow: hidden;
  background: var(--white, #fff);
  border: 1px solid var(--border, #D8D3C8);
}
.qp__img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* ── Content column ────────────────────────────────────────── */
.qp__content {
  flex: 1;
  min-width: 180px;
}

.qp__badge {
  display: inline-block;
  background: var(--green, #1E3A28);
  color: var(--gold, #C8A84B);
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 4px 12px;
  border-radius: var(--r3);
  margin-bottom: 8px;
}

.qp__name {
  font-family: var(--font-display, 'DM Serif Display', serif);
  font-size: 19px;
  font-weight: 400;
  color: var(--green, #1E3A28);
  margin: 0 0 4px;
  line-height: 1.3;
}

.qp__stars {
  font-size: 16px;
  color: var(--gold, #C8A84B);
  letter-spacing: 1.5px;
  margin-bottom: 8px;
}
.qp__stars-num {
  font-size: 16px;
  font-weight: 700;
  color: var(--muted, #556B5C);
  letter-spacing: 0;
  margin-left: 4px;
}

.qp__best-for {
  font-size: 16px;
  color: var(--muted, #556B5C);
  margin: 0 0 4px;
  line-height: 1.4;
}

.qp__why {
  font-size: 16px;
  font-style: italic;
  color: var(--body, #2D3F32);
  margin: 0;
  line-height: 1.5;
}

/* ── Actions column ────────────────────────────────────────── */
.qp__actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex-shrink: 0;
}

.qp__cta {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--green, #1E3A28);
  color: #fff;
  padding: 12px 20px;
  border-radius: var(--r1);
  text-decoration: none;
  font-weight: 700;
  transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
  white-space: nowrap;
}
.qp__cta:hover {
  background: #1a5c35;
  transform: translateY(-1px);
  box-shadow: var(--s1);
}
.qp__cta-price { font-size: 20px; font-weight: 800; }
.qp__cta-text  { font-size: 16px; font-weight: 700; }

.qp__alt {
  display: block;
  text-align: center;
  color: var(--green, #1E3A28);
  font-size: 16px;
  font-weight: 700;
  text-decoration: none;
  padding: 8px 16px;
  border: 2px solid var(--green, #1E3A28);
  border-radius: var(--r1);
  transition: background 0.15s;
}
.qp__alt:hover { background: rgba(30, 58, 40, 0.06); }

/* ── Disclosure ────────────────────────────────────────────── */
.qp__disclosure {
  font-size: 16px;
  color: var(--muted, #556B5C);
  margin: 0;
  padding: 0 24px 12px;
  text-align: center;
}

/* ── Mobile ────────────────────────────────────────────────── */
@media (max-width: 640px) {
  .qp__inner {
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
    padding: 20px 20px 12px;
  }
  .qp__img-wrap {
    width: 64px;
    height: 64px;
  }
  .qp__name { font-size: 17px; }
  .qp__cta {
    justify-content: center;
    padding: 16px 16px;
  }
  .qp__alt { text-align: center; }
  .qp__disclosure { padding: 0 20px 12px; }
}
</style>
