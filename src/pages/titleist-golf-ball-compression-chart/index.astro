---
// Titleist golf ball compression chart — Sprint 100.
// Targets the brand-qualified query cluster only. The unqualified head term
// stays with the all-brands chart (the site's biggest earner); rationale and
// the GSC evidence are documented in BrandCompressionChart.astro.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandCompressionChart from '../../components/BrandCompressionChart.astro';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';
import { brandFaqFacts, FULL_CHART_BLURB } from '../../data/ball-brands';

// Sprint 165: these three answers and the full-chart blurb are derived from
// balls.ts instead of typed. Typed by hand they undercounted the chart by a ball
// and a brand, and on Titleist they named the 70-compression TruFeel as its
// softest ball while the table two screens above showed two balls at 65.
const facts = brandFaqFacts('Titleist');

import { ROBOTS_INDEX } from '../../lib/seo';
const meta = {
  title: "Titleist Golf Ball Compression Chart 2026 \u2014 All 7",
  description: "Compression, cover and price for all 7 Titleist golf balls, from the Tour Soft (65) to the Pro V1x (97), matched to your swing speed.",
  canonical: 'https://www.cubicalgolfer.com/titleist-golf-ball-compression-chart/',
  ogImage: 'https://www.cubicalgolfer.com/images/og/golf-ball-compression-chart.jpg',
  ogType: 'article' as const,
  robots: ROBOTS_INDEX,
  breadcrumbs: [
    { label: 'Home', href: '/' },
    { label: 'Compression Chart', href: '/golf-ball-compression-chart/' },
    { label: "Titleist Compression", href: "/titleist-golf-ball-compression-chart/" },
  ],
};

const faq = [
  { q: "What is the compression of Titleist golf balls?", a: facts.range },
  { q: "Which Titleist golf ball is the softest?", a: facts.softest },
  { q: "Which Titleist ball suits my swing speed?", a: "Match compression to driver speed. Under 85 mph suits the softer end of the Titleist range; 85-100 mph the middle; over 100 mph the firmest. The table above lists the rated speed range for every Titleist ball." },
  { q: "How many Titleist golf balls are on this chart?", a: facts.howMany },
];

const siblings = [{"brand": "Callaway", "slug": "/callaway-golf-ball-compression-chart/"}, {"brand": "TaylorMade", "slug": "/taylormade-golf-ball-compression-chart/"}, {"brand": "Srixon", "slug": "/srixon-golf-ball-compression-chart/"}, {"brand": "Bridgestone", "slug": "/bridgestone-golf-ball-compression-chart/"}];
const schemas = [breadcrumbSchema(meta.breadcrumbs), faqSchema(faq)];
---

<BaseLayout {meta} {schemas} activeNav="improve">
  <article class="art-content" style="margin:0 auto;padding:0 var(--page-px) 60px;">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">&#8250;</span>
      <a href="/golf-ball-compression-chart/">Compression Chart</a>
      <span aria-hidden="true">&#8250;</span>
      <span>Titleist</span>
    </nav>

    <h1>Titleist Golf Ball Compression Chart</h1>

    <BrandCompressionChart brand="Titleist" siblings={siblings} />

    <section style="background:#f8f7f4;border-radius:8px;padding:18px;margin:26px 0;">
      <p style="margin:0 0 8px;font-weight:700;">Want every brand in one table?</p>
      <p style="margin:0 0 12px;">{FULL_CHART_BLURB}</p>
      <a href="/golf-ball-compression-chart/" style="background:#1E3A28;color:#fff;padding:10px 20px;border-radius:8px;font-weight:700;text-decoration:none;">Open the full compression chart &#8594;</a>
    </section>

    <section>
      <h2 id="faq">Frequently Asked Questions</h2>
      {faq.map(f => (
        <div style="margin-bottom:16px;">
          <h3 style="margin-bottom:6px;">{f.q}</h3>
          <p style="margin:0;">{f.a}</p>
        </div>
      ))}
    </section>
  </article>
</BaseLayout>
