---
import { AUTHOR_PROFILE } from '../../data/author';
import { balls as BALLS } from '../../data/balls.ts';
import { BRAND_DETAIL } from '../../data/ball-brands';
// Brands that now have their own exact-match page (Sprint 100). The section
// stays put so this chart remains the complete one; it just links onward.
const BRAND_PAGES = new Set(['Callaway','Titleist','TaylorMade','Srixon','Bridgestone']);
import { AFFILIATE } from '../../data/affiliate-links';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StickyBar from '../../components/StickyBar.astro';
import { getAffiliateLink } from '../../data/affiliate-links';

// Sprint 165: the figures in the under-85 mph section are derived from
// balls.ts. Typed by hand they had drifted on every one: the Supersoft was
// listed at $25 (really $27), the DUO Soft+ at $22 (really $25, so not
// "under $25" at all), the Noodle at $20 (really $19).
//
// One of them was not a price typo. The Vice Drive was named "the cheapest
// quality ball for slow swingers" inside a section headed "Under 85 mph",
// while its own row on this same page says it needs 95 mph or more to
// compress and that slower swingers should take the Noodle or the Supersoft
// instead. The page was recommending a ball against its own data, so the
// Drive comes out of the slow-swinger list. It keeps its row, its link and
// its budget-pick badge everywhere else on the site; nothing is removed.
//
// WHICH balls get named here stays an editorial choice and is unchanged
// otherwise — the three below are the ones balls.ts itself nominates for
// slow swingers. Only the numbers are computed.
const ball = (name: string) => (BALLS as any[]).find(b => b.name === name)!;
const slowPick = ball('Callaway Supersoft');
const slowAlt  = ball('Wilson DUO Soft+');
const slowBudget = [ball('TaylorMade Noodle'), slowAlt, slowPick]
  .sort((a, b) => a.price - b.price);
// Round the heading's cap up to the next $5 so it reads like a price tier
// rather than the exact figure of whichever ball happens to be dearest.
const budgetCap = Math.ceil(slowBudget[slowBudget.length - 1].price / 5) * 5;

// Sprint 169: the swing-speed recommendation paragraphs quoted their own
// figures. Four were wrong against the table on the same page — Chrome Soft
// at $40 (really $45), Pro V1 at $55 ($58), TP5 at $50 ($58), and Vice Pro at
// "$33/dz, 80 compression" when balls.ts has it at $39 and 90. The Vice Pro
// error is the same one Sprint 165 found in the brand commentary, which is the
// tell: a figure typed beside a product name drifts the moment balls.ts moves.
// pill() renders "name ($price/dz, cover, compression)" from the record.
const pill = (name: string, opts: { cover?: boolean; label?: string } = {}) => {
  const b = ball(name);
  const bits = [`$${b.price}/dz`];
  if (opts.cover) bits.push(String(b.cover).toLowerCase());
  bits.push(opts.label ? `${b.compression} ${opts.label}` : String(b.compression));
  return `<strong>${b.name}</strong> (${bits.join(', ')})`;
};
// Thumbnail lookup. This used to slugify the ball's NAME and hope it matched a
// registry key — so 'Callaway Chrome Tour' looked for `callaway-chrome-tour`
// while the entry is `callaway-chrome-tour-2026`, and the row silently rendered
// no image. BALL_ALIASES existed to hand-patch exactly one earlier instance of
// the same bug. Every ball now carries an affKey, so match on that and the
// name/key mismatch cannot bite again.
const ballThumb = (ball: any): string | undefined => {
  const e: any = ball?.affKey ? getAffiliateLink(ball.affKey) : undefined;
  return e && e.imgSrc ? e.imgSrc : undefined;
};
import { articleSchema, faqSchema, breadcrumbSchema } from '../../lib/schema';
import { effectiveDateModified } from '../../lib/freshness';
import { ARTICLES } from '../../data/articles';
import EmbedBox from '../../components/EmbedBox.astro';

const article = ARTICLES.find(a => a.slug === '/golf-ball-compression-chart/')!;

// Sprint 134: schema said 2026-07-23 while the sitemap said 2026-09-29.
// One date, derived, so the two can never disagree again.
const updatedOn = effectiveDateModified('/golf-ball-compression-chart/', article.dateModified) ?? article.datePublished;

const meta = {
  title: 'Golf Ball Compression Chart 2026 — 36 Balls + PDF',
  description: 'Sortable chart of 36 golf balls — Titleist, Callaway, TaylorMade, Srixon. Filter by brand, cover or price, or enter your swing speed. Free printable PDF.',
  canonical: 'https://www.cubicalgolfer.com/golf-ball-compression-chart/',
  ogImage: 'https://www.cubicalgolfer.com/images/og/golf-ball-compression-chart.jpg',
  ogType: 'article' as const,
  robots: ROBOTS_INDEX,
  breadcrumbs: [
    { label: 'Home', href: '/' },
    { label: 'Improve Your Game', href: '/improve-your-golf-game/' },
    { label: 'Compression Chart', href: '/golf-ball-compression-chart/' },
  ],
};

const TAG = 'cubicalgolfer-20';

const balls = BALLS;

// NOTE: every ball now carries an affKey, so the registry always wins and the
// legacy `asin` fields below are never read. That matters: SEVEN of the nine
// hardcoded ASINs on this page were dead Amazon 404s (verified 2026-08-22) on the
// page carrying 28% of the site's impressions, and no build check could see them
// because they never went through the affiliate registry.
function ballUrl(ball: typeof balls[0]): string | null {
  // Prefer the registry: it is the maintained, validated source and six sprints of
  // ASIN verification live there. This page kept its own ball table, so that work
  // never reached the site's biggest page — 25 of 35 balls still linked to search.
  // Amazon no longer prices these. A "Check price" link to a search that returns
  // nothing earns zero and costs trust, so the row keeps its compression data
  // and loses the button.
  if ((ball as any).discontinued) return null;
  const aff = (ball as any).affKey ? (AFFILIATE as any)[(ball as any).affKey] : null;
  if (aff?.url) return aff.url;
  return ball.asin
    ? `https://www.amazon.com/dp/${ball.asin}/?tag=${TAG}`
    : `https://www.amazon.com/s?k=${ball.search}&tag=${TAG}`;
}

const brands = ['Titleist', 'Callaway', 'TaylorMade', 'Srixon', 'Bridgestone', 'Vice', 'Kirkland'];

// Per-brand editorial. Every figure here is derived from the `balls` array above —
// compression, cover material, price and swing-speed range — so nothing can drift
// out of sync with the table without the table changing first. No compression
// value is asserted that is not already published in the chart.
// BRAND_DETAIL now lives in src/data/ball-brands.ts (shared with the brand pages).



const faqs = [
  { q: "Why do golf ball compression charts disagree with each other?", a: "Because there is no industry-standard compression test. Manufacturers publish figures measured on their own rigs; independent labs publish gauge readings from theirs, and the two scales do not line up. Gaps of 20 points or more on the same ball are normal, and both numbers can be honest. The Titleist TruFeel is a clear case: Titleist publishes no figure at all, MyGolfSpy’s 2026 test gauged it at 70 and Today’s Golfer measured 68, while the ball is marketed as ultra-soft. Every row in the chart above carries a Source column saying which scale that number came from, so you can tell a published spec from a measured reading. Numbers taken from different scales should not be compared directly." },
  { q: "Does Titleist publish golf ball compression ratings?", a: "No. Titleist does not publish a compression figure for any ball in its line, including the Pro V1, Pro V1x, AVX, Tour Soft, Velocity and TruFeel. Every Titleist compression number you see online is an independent measurement or an estimate, which is why they vary so widely between sources. Costco does the same with the Kirkland Signature, so the 92 in the chart above is MyGolfSpy Ball Lab’s measured average rather than a manufacturer specification." },
  { q: "Which golf ball compression numbers are measured and which are published by the manufacturer?", a: "On this chart, the Source column marks each one. Callaway, TaylorMade, Srixon, Bridgestone, Wilson and Vice publish their own compression figures, and where they do we use the manufacturer number. Titleist and Costco publish nothing, so those rows carry an independent measurement instead — MyGolfSpy’s 2026 ball test for the TruFeel and MyGolfSpy Ball Lab for the Kirkland Signature. Mixing the two scales in one comparison is the most common reason two charts appear to contradict each other." },
  { q: 'What golf ball compression should I use?', a: 'Match compression to your driver swing speed. Under 85 mph: play compression 35-65. Between 85-100 mph: play compression 65-90. Over 100 mph: play compression 90-102. The interactive calculator above gives you a personalized recommendation.' },
  { q: 'Does golf ball compression affect distance?', a: 'Yes. If the compression is too high for your swing speed, you cannot fully compress the ball at impact, losing energy transfer and distance. A 75 mph swinger playing a Pro V1 (87 compression) will hit it shorter than a Callaway Supersoft (38 compression). The right compression maximizes energy transfer for YOUR speed.' },
  { q: 'What is the compression of a Titleist Pro V1?', a: 'The Titleist Pro V1 has a compression of 87. It is designed for swing speeds of 90-115 mph. If your driver swing speed is below 90 mph, the Tour Soft (65 compression) or AVX (77 compression) will give you better distance and feel.' },
  { q: 'What compression is a Callaway Supersoft?', a: 'The Callaway Supersoft has a compression of 38 — one of the lowest on the market. It is ideal for swing speeds under 80 mph, seniors, and beginners. The soft feel and low compression help slower swingers maximize distance.' },
  { q: 'What is a good compression for a senior golfer?', a: 'Most senior golfers benefit from compression between 35-65. The Callaway Supersoft (38), Wilson DUO Soft+ (40), and Srixon Soft Feel (60) are the best options. These compress fully at slower swing speeds, maximizing distance without sacrificing feel.' },
  { q: 'Is higher or lower compression better?', a: 'Neither — it depends on your swing speed. Lower compression (35-65) is better for slower swingers because the ball compresses more easily. Higher compression (85-102) is better for faster swingers because it resists deformation and transfers more energy. Playing the wrong compression in either direction costs distance.' },
  { q: 'What compression are Kirkland golf balls?', a: 'Kirkland Signature golf balls measure about 92 compression with a urethane cover. At $28 per dozen ($2.33 per ball), they offer tour-level construction at a fraction of the Pro V1 price. Best for swing speeds of 85-100 mph.' },
  { q: 'What compression is a TaylorMade TP5?', a: 'The TaylorMade TP5 has a compression of 85, and the firmer TP5x sits at 97. TaylorMade\'s lineup on this chart runs from the ultra-soft Noodle (34) and Soft Response (50) up through the Tour Response (77) to the TP5 (85) and TP5x (97) — so there is a TaylorMade ball for every swing speed from beginner to tour.' },
  { q: 'What compression is a Callaway Chrome Soft?', a: 'The Callaway Chrome Soft has a compression of 75 with a urethane cover, making it one of the softest tour balls available. Callaway\'s range on this chart spans the Supersoft (38) for slow swings up to the Chrome Tour (90) for fast swings, with the Chrome Soft and Warbird (68) in between.' },
  { q: 'How do I know what compression golf ball to use based on swing speed?', a: 'Use the interactive calculator at the top of this page — enter your driver swing speed and it recommends three balls (budget, balanced, premium). If you do not know your swing speed, use the 7-iron carry distance estimator: 110 yards ≈ 72 mph, 130 yards ≈ 82 mph, 150 yards ≈ 92 mph, 170 yards ≈ 102 mph.' },
  { q: 'What is the softest Titleist golf ball?', a: 'The TruFeel, $25 a dozen. Titleist publishes no compression figure for it: MyGolfSpy gauged it at 70 in 2026 and Today\'s Golfer at 68. It is still the softest of the seven Titleist balls on this chart, but firmer than the ultra-soft marketing implies. Note it is ionomer-covered, so it will not generate the greenside spin of a urethane ball however soft it feels off the face.' },
  { q: 'What is the cheapest Titleist ball with a urethane cover?', a: 'The Tour Speed at 78 compression and $35 a dozen. That is $22 less than a Pro V1 for a ball only nine compression points softer, which makes it the cheapest route into Titleist urethane and the value pick in the lineup below 90 mph.' },
  { q: 'What is the cheapest urethane golf ball?', a: 'The Kirkland Signature, which works out near $22 a dozen because it is sold in two-dozen boxes at $43.99. Among the traditional manufacturers the cheapest urethane is the Wilson Staff Model at $35, then the Titleist Tour Speed at $35. The Srixon Q-Star Tour is $40 and the Vice Pro Soft $35. Urethane is what produces greenside spin, so either is the cheapest route to a ball that checks on a pitch.' },
  { q: 'Which TaylorMade ball should I play at 90 mph?', a: 'The Tour Response at 77 compression, $38. It is rated 88–105 mph, it is urethane-covered, and it is $12 cheaper than the TP5. The TP5 and TP5x are rated 95–115 and 100–130 mph respectively, so both are firmer than a 90 mph swing needs.' },
  { q: 'Which Bridgestone golf ball has the lowest compression?', a: 'The e12 Contact at 50 compression, $30 a dozen, rated 70–90 mph. It is also the only ionomer-covered ball Bridgestone has on this chart — the Tour B RX at 68 is already urethane, which is unusually low for a urethane ball.' },
  { q: 'What is the firmest golf ball?', a: 'The Srixon Z-Star XV at 102 compression is the firmest of the 36 balls on this chart, followed by the Bridgestone Tour B X and Maxfli Tour X at 100. All three are rated for swing speeds above 100 mph and will feel harsh below that.' },
  { q: 'What is the difference between the Titleist Tour Soft and Velocity?', a: 'They are both 65 compression, which makes them look identical on a chart, but they are built for different jobs. Tour Soft is rated 80–95 mph and designed for feel. Velocity is rated 85–110 mph and designed for distance. Compression alone will not tell you which one suits you.' },
  { q: 'Does temperature affect golf ball compression?', a: 'Yes. Cold temperatures make golf balls harder (effectively increasing compression by 5-10 points). In winter or early morning rounds below 50°F, drop down one compression bracket. If you normally play a 75-compression ball, switch to a 60-65 in cold weather for the same feel and distance.' },
];

// ItemList schema for Google ranking carousel
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Golf Ball Compression Chart 2026',
  description: '36 golf balls ranked by compression rating from lowest (34) to highest (102)',
  numberOfItems: balls.length,
  itemListElement: balls.map((ball, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: ball.name,
    description: ball.notes || `${ball.name} — ${ball.compression} compression, ${ball.cover} cover, ~$${ball.price}/dozen`,
  })),
};


// Sprint 135: declare the chart image so it is unambiguous which picture on the
// page IS the chart. Google needs no special markup for AI Overviews and we are
// not pretending otherwise — this is for Google Images.
const chartImageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: 'https://www.cubicalgolfer.com/images/charts/golf-ball-compression-chart-2026.webp',
  url: 'https://www.cubicalgolfer.com/golf-ball-compression-chart/',
  width: 1200,
  height: 675,
  name: 'Golf Ball Compression Chart 2026',
  caption: 'Golf ball compression chart 2026: 36 golf balls grouped into four compression bands — ultra-soft 34-50 for under 85 mph, soft-mid 55-74 for 85-100 mph, mid-firm 75-87 for 90-110 mph and firm-high 88-102 for 100+ mph — with the compression rating for each ball',
  creditText: 'CubicalGolfer.com',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  acquireLicensePage: 'https://www.cubicalgolfer.com/golf-ball-compression-chart/',
};

// Dataset schema for Google Dataset Search
const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Golf Ball Compression Chart 2026',
  description: '36 golf balls ranked by compression rating (34–102) with cover material, price per dozen, and recommended swing speed range.',
  url: 'https://www.cubicalgolfer.com/golf-ball-compression-chart/',
  creator: {
    '@type': 'Organization',
    name: 'CubicalGolfer.com',
    url: 'https://www.cubicalgolfer.com',
  },
  license: 'https://creativecommons.org/licenses/by/4.0/',
  dateModified: updatedOn,
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/pdf',
    contentUrl: 'https://www.cubicalgolfer.com/downloads/golf-ball-compression-chart-2026.pdf',
  },
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'Compression Rating', minValue: 34, maxValue: 102 },
    { '@type': 'PropertyValue', name: 'Price Per Dozen (USD)', minValue: 17, maxValue: 58 },
  ],
};

const schemas = [
  itemListSchema,
  datasetSchema,
  articleSchema({ ...article, dateModified: updatedOn }),
  chartImageSchema,
  breadcrumbSchema(meta.breadcrumbs),
  faqSchema(faqs),
];
import EarlyDisclosure from '../../components/EarlyDisclosure.astro';
import { ROBOTS_INDEX } from '../../lib/seo';

// Sprint 131: this was hardcoded data-outbound="amazon" on every row, so the
// three Golf Galaxy balls on the chart (Soft Response, Maxfli Tour X, Maxfli
// Tour S) reported their clicks to Plausible as Amazon clicks. The chart is
// ~35% of site clicks, so that quietly inflated the Amazon EPC the whole
// affiliate model is built on. Derive it from the destination instead.
function outboundFor(url: string | null | undefined): string {
  if (!url) return 'other';
  if (url.includes('amazon.com')) return 'amazon';
  if (url.includes('golfgalaxy.com') || url.includes('dickssportinggoods.com')) return 'golfgalaxy';
  if (url.includes('playbetter')) return 'playbetter';
  if (url.includes('bushnell')) return 'bushnell';
  return 'other';
}
---
<BaseLayout meta={meta} schemas={schemas}>

  <!-- STICKY BAR -->


  <header class="art-hero">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="bc-sep" aria-hidden="true">›</span>
      <a href="/improve-your-golf-game/">Improve Your Game</a>
      <span class="bc-sep" aria-hidden="true">›</span>
      <span aria-current="page">Golf Ball Compression Chart</span>
    </nav>

    <span class="art-tag-lg tag-guide">INTERACTIVE CHART</span>
    <h1>Golf Ball Compression Chart 2026 — Match Any Ball to Your Swing Speed</h1>


      <EarlyDisclosure />

    <div class="author-box">
      <a href="/about/" style="flex-shrink:0" aria-label="About Ryan O. — Cubical Golfer">
        <img src="/images/ryan-author-photo.webp" alt="Ryan O., Cubical Golfer founder and gear editor" class="author-avatar-img" width="44" height="44" />
      </a>
      <div style="flex:1">
        <span class="author-name">
          <a href="/about/">Ryan O.</a>
          <span class="byline-tagline" style="font-size:16px;font-weight:400;margin-left:6px">{AUTHOR_PROFILE.handicapLabel} weekend golfer, {AUTHOR_PROFILE.city}</span>
        </span>
        <span class="author-meta">
          📖 16 min read &nbsp;·&nbsp;
          📅 Updated: {updatedOn} &nbsp;·&nbsp;
          ⛳ <a href="/how-we-test/">How we test →</a>
        </span>
      </div>
    </div>
  </header>

  <!-- TRUST CARD — same as other buying guides -->
  <div class="trust-card">
    <p class="trust-card__heading">Why Trust This Guide</p>
    <ul class="trust-card__list">
      <li><strong>Every ball purchased</strong> — bought with our own money, no manufacturer samples</li>
      <li><strong>Compression data verified</strong> — cross-referenced with manufacturer specs and independent testing</li>
      <li><strong>{AUTHOR_PROFILE.handicapLabel} perspective</strong> — recommendations for weekend golfers, not tour pros</li>
      <li><strong>Updated {updatedOn}</strong> — prices and availability checked monthly</li>
    </ul>
    <a href="/how-we-test/" class="trust-card__link">See full testing methodology →</a>
  </div>

  <article class="art-content">

    <!-- QUICK ANSWER -->
    <div class="quick-answer-box">
      <div class="quick-answer-header">⚡ Quick Answer</div>
      <p class="quick-answer-text">Under 85 mph swing speed: play compression 35-65. Between 85-100 mph: play 65-90. Over 100 mph: play 90+. Use the interactive calculator below to get a personalized recommendation in 10 seconds.</p>
      <a href={getAffiliateLink('callaway-supersoft').url} class="quick-answer-cta" target="_blank" rel="nofollow noopener sponsored" data-cta-location="quick-answer" data-aff-name="Callaway Supersoft">Our #1 Pick: Callaway Supersoft {getAffiliateLink('callaway-supersoft').price} — Check Price →</a>
      <p class="quick-answer-more">Read the full guide below for all 36 balls tested.</p>
    </div>

    <!-- FRESHNESS BANNER -->
    <div class="freshness-banner" style="margin:16px 0 20px;padding:12px 16px;background:rgba(30,58,40,.05);border-left:3px solid var(--green);border-radius:0 8px 8px 0;font-size:16px;color:var(--muted);display:flex;align-items:center;gap:8px;">
      <span style="font-size:16px;">✅</span>
      <span><strong>Updated {updatedOn}</strong> — All 36 balls independently purchased and tested. No manufacturer loans. <a href="/how-we-test/" style="color:var(--green);font-weight:600;">How we test →</a></span>
    </div>

    <!-- PDF DOWNLOAD -->
    <div style="margin:0 0 20px;padding:16px 20px;background:var(--gold);border-radius:10px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <p style="margin:0;font-weight:700;font-size:16px;color:#1a1a1a;">Download the Golf Ball Compression Chart (PDF)</p>
        <p style="margin:4px 0 0;font-size:16px;color:#333;">Printable version — same data, take it to the range or pro shop. The cheat sheet is the one-page version: your band, the balls in it, and where each number came from.</p>
      </div>
      <a href="/downloads/golf-ball-compression-chart-2026.pdf" download style="background:#1E3A28;color:#fff;padding:10px 20px;border-radius:8px;font-weight:700;font-size:16px;text-decoration:none;white-space:nowrap;">Download 2026 Chart (PDF) →</a>
      <a href="/downloads/compression-cheat-sheet.pdf" download style="background:transparent;color:#1E3A28;border:2px solid #1E3A28;padding:8px 18px;border-radius:8px;font-weight:700;font-size:16px;text-decoration:none;white-space:nowrap;">One-page cheat sheet (PDF) →</a>
    </div>

    <!-- TOC -->
    <nav class="toc" aria-label="Table of contents">
      <p class="toc-heading">In this guide</p>
      <ol>
        <li><a href="#ball-finder">Find Your Ball in 10 Seconds</a></li>
        <li><a href="#compression-table">Full Compression Chart (Sortable)</a></li>
        <li><a href="#what-is-compression">What Is Compression?</a></li>
        <li><a href="#find-swing-speed">How to Find Your Swing Speed</a></li>
        <li><a href="#under-85">Best Balls Under 85 mph</a></li>
        <li><a href="#85-100">Best Balls 85-100 mph</a></li>
        <li><a href="#over-100">Best Balls Over 100 mph</a></li>
        <li><a href="#by-brand">Compression Chart by Brand</a>
          <ul style="margin:6px 0 0 18px;padding:0;list-style:disc;font-size:15px;">
            <li><a href="#titleist">Titleist</a></li>
            <li><a href="#callaway">Callaway</a></li>
            <li><a href="#taylormade">TaylorMade</a></li>
            <li><a href="#srixon">Srixon</a></li>
            <li><a href="#bridgestone">Bridgestone</a></li>
            <li><a href="#vice">Vice</a></li>
          </ul>
        </li>
        <li><a href="#faq">FAQ</a></li>
      </ol>
    </nav>

    <!-- Sprint 135: the image-pack candidate. Three competitors sit above every
         organic result on "golf ball compression chart 2026" with a picture;
         our chart was an HTML table so Google had nothing to pull. Generated
         from balls.ts by scripts/generate-compression-chart-image.ts.
         Alt text is the #1 image-pack ranking factor, so it is specific. -->
    <!-- Sprint 137: moved out of the hero to sit under the table of contents.
         In the hero it was the first thing on the page — a STATIC picture
         standing in front of the actual interactive tool, and rendered at the
         full container width its type was enormous. Capped at 880px so it
         reads at a sensible size, and now on the light body so the caption
         uses ordinary body colours again. -->
    <figure style="margin:0 0 32px;max-width:880px;">
      <img src="/images/charts/golf-ball-compression-chart-2026.webp"
           width="1200" height="675" loading="eager" fetchpriority="high"
           alt="Golf ball compression chart 2026: 36 golf balls grouped into four compression bands — ultra-soft 34-50 for under 85 mph, soft-mid 55-74 for 85-100 mph, mid-firm 75-87 for 90-110 mph and firm-high 88-102 for 100+ mph — with the compression rating for each ball"
           style="width:100%;height:auto;border-radius:12px;display:block;" />
      <figcaption style="font-size:14px;color:var(--muted);margin-top:8px;">
        Golf ball compression chart 2026 — all {balls.length} balls we track, grouped by compression band and swing speed.
        <a href="/images/charts/golf-ball-compression-chart-2026-full.webp" >See every ball in one image</a>.
      </figcaption>
    </figure>


    <p class="chart-intro">Stop guessing which golf ball to play. This chart maps the compression rating of all 36 balls — every Titleist, Callaway, TaylorMade, Srixon, Bridgestone, Vice, Wilson, Kirkland, Maxfli and Pinnacle model we track — to your swing speed, so you can find the right ball in 10 seconds instead of wasting money on balls built for someone else's swing.</p>

    <!-- ═══ INTERACTIVE BALL FINDER ═══ -->
    <section class="ball-finder" id="ball-finder">
      <h2 id="ball-finder-heading" style="margin-top:0;color:var(--green);">🎯 Find Your Ball in 10 Seconds</h2>
      <div class="finder-controls">
        <label for="speed-slider" style="font-weight:600;">Your driver swing speed (mph):</label>
        <div class="speed-input-group">
