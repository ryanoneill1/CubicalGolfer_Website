---
import { AFFILIATE } from '../../data/affiliate-links';
import { CHART_BALL_COUNT } from '../../data/ball-brands';
import { balls as CHART_BALLS } from '../../data/balls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbSchema, faqSchema , webApplicationSchema } from '../../lib/schema';

const meta = {
  title: 'Golf Ball Finder — Match Your Swing Speed to the Right Ball',
  description: 'Find the right golf ball for your swing speed and budget. Filter every ball on our compression chart by compression, cover and price.',
  canonical: 'https://www.cubicalgolfer.com/golf-ball-finder/',
  ogImage: 'https://www.cubicalgolfer.com/images/og/golf-ball-finder.jpg',
  ogType: 'website' as const,
  robots: ROBOTS_INDEX,
  breadcrumbs: [
    { label: 'Home', href: '/' },
    { label: 'Tools', href: '/tools/' },
    { label: 'Golf Ball Finder', href: '/golf-ball-finder/' },
  ],
};

const faq = [
  { q: 'What compression golf ball should I use?', a: 'Match compression to swing speed. Under 85 mph driver speed: 35-65 compression (soft). 85-100 mph: 65-90 compression (mid). Over 100 mph: 90+ compression (firm). The wrong compression wastes distance — a slow swing cannot compress a firm ball enough to get the energy transfer.' },
  { q: 'Does golf ball compression really matter?', a: 'Yes — compression affects distance, feel, and spin at your specific swing speed. A slow-swing golfer playing a high-compression tour ball loses 5-15 yards compared to a properly matched low-compression ball. The effect is most pronounced off the driver and long irons.' },
  { q: 'What is the best golf ball for a 90 mph swing speed?', a: 'At 90 mph driver speed, mid-compression balls (65-85) perform best. The Callaway Chrome Soft (75 compression), TaylorMade Tour Response (73), and Srixon Q-Star Tour (67) are all excellent choices that balance distance and greenside spin at this speed.' },
  { q: 'Are expensive golf balls worth it for high handicappers?', a: 'Usually not. A high handicapper loses 3-6 balls per round — at $50 per dozen for premium balls, that adds up fast. A $25 ball like the Callaway Supersoft or Srixon Soft Feel delivers 90% of the performance at half the price for swing speeds under 95 mph.' },
];

const schemas = [
  webApplicationSchema({ name: 'Golf Ball Finder', description: 'Filter every golf ball on our compression chart by swing speed, budget and feel to find your ball.', url: '/golf-ball-finder/' }),breadcrumbSchema(meta.breadcrumbs), faqSchema(faq)];

// Ball data — same source as the compression chart
// Tracked buy links per ball, resolved from src/data/affiliate-links.ts.
// Only affiliate keys that already exist are used — no products were invented.
// Bridgestone e6 has no entry; the tool lists "Tour B RXS" but only a "Tour B RX"
// entry exists and they are different compressions, so both stay unlinked.
const BALL_URLS: Record<string,string> = Object.fromEntries(
  Object.entries(AFFILIATE as any).map(([k, v]: any) => [k, v.url]));

// Sprint 214 — this tool used to carry its OWN hardcoded copy of the ball
// data. It had drifted badly: 16 of its 19 rows disagreed with balls.ts, including
// five wrong compression figures (Srixon Soft Feel charted 50 against a published
// 60, Vice Pro 75 against 90, TaylorMade Tour Response 70 against 77, Callaway
// Chrome Tour 87 against 90, Titleist AVX 78 against 77) and most prices and speed
// bands. The page told readers the data came from the compression chart while
// showing different numbers to the chart. It is now derived, so it cannot drift.
//
// `feel` is computed from compression rather than stored, and `bestFor` is the one
// editorial field: curated where we have a line worth keeping, derived from the
// ball's own cover and speed band otherwise.
const FEEL = (c: number) =>
  c < 50 ? 'Ultra Soft' : c < 70 ? 'Soft' : c < 85 ? 'Mid' : c < 95 ? 'Mid-Firm' : 'Firm';

const BEST_FOR: Record<string, string> = {
  'taylormade-noodle':        'Beginners, slow swings',
  'callaway-supersoft':       'Seniors, max distance at low speed',
  'wilson-duo-soft-plus':     'Straight flight, budget-friendly',
  'titleist-trufeel':         'Short-game feel on a budget',
  'srixon-soft-feel':         'Best value under $25',
  'vice-drive':               'Cheapest playable ball',
  'kirkland-signature':       'Best value urethane ball',
  'srixon-q-star-tour':       'Tour spin at mid-compression',
  'taylormade-tour-response': 'Distance + greenside spin',
  'callaway-chrome-soft':     'All-around performance',
  'vice-pro':                 'Premium feel at mid-tier price',
  'titleist-avx':             'Low flight, low spin off driver',
  'taylormade-tp5':           'Max distance with tour spin',
  'callaway-chrome-tour-2026':'Tour-level greenside control',
  'titleist-pro-v1':          'The benchmark tour ball',
  'titleist-pro-v1x':         'High launch, high spin',
  'taylormade-tp5x':          'Max distance for fast swings',
};

const balls = CHART_BALLS
  .filter((b: any) => !b.discontinued)
  .map((b: any) => ({
    name: b.name,
    brand: b.brand,
    compression: b.compression,
    cover: b.cover,
    feel: FEEL(b.compression),
    price: b.price,
    minMph: b.minMph,
    maxMph: b.maxMph,
    bestFor: BEST_FOR[b.affKey]
      ?? `${b.cover === 'Urethane' ? 'Greenside spin' : 'Distance and durability'}, ${b.minMph}-${b.maxMph} mph`,
    affiliateKey: b.affKey,
  }))
  .sort((a: any, b: any) => a.compression - b.compression);
import EarlyDisclosure from '../../components/EarlyDisclosure.astro';
import { ROBOTS_INDEX } from '../../lib/seo';
---

<BaseLayout {meta} {schemas} activeNav="tools">
  <article class="art-content" style="margin:0 auto;padding:0 var(--page-px) 60px;">
    <header class="art-hero">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="bc-sep" aria-hidden="true">›</span>
        <a href="/tools/">Tools</a>
        <span class="bc-sep" aria-hidden="true">›</span>
        <span aria-current="page">Golf Ball Finder</span>
      </nav>
      <h1>Golf Ball Finder — Match Your Swing Speed to the Right Ball</h1>
      <EarlyDisclosure />
      <p class="art-excerpt" style="color:rgba(255,255,255,.85);">Stop buying the wrong golf ball. Enter your swing speed, budget, and what you care about most — this tool filters every ball on our compression chart and gives you a personalized recommendation in seconds. Data from our <a href="/golf-ball-compression-chart/" style="color:#C8A84B;text-decoration:underline;">compression chart</a>, independently verified.</p>
    </header>

    <p style="font-size:16px;color:var(--muted);margin:0 0 20px;">Last updated: November 2026. See the full <a href="/golf-ball-compression-chart/">Golf Ball Compression Chart</a> for detailed data on all {CHART_BALL_COUNT} balls.</p>

    <!-- FILTERS -->
    <section style="padding:24px;background:rgba(30,58,40,.04);border:1px solid var(--border);border-radius: var(--r2);margin:0 0 28px;">
      <h2 style="font-size:18px;color:var(--green);margin:0 0 16px;">Filter by your game</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;">
        <div>
          <label for="bf-speed" style="font-weight:600;font-size:16px;display:block;margin:0 0 6px;">Driver swing speed</label>
          <select id="bf-speed" style="width:100%;padding:10px;border:1px solid var(--border);border-radius: var(--r2);font-size:16px;">
            <option value="0">Any speed</option>
            <option value="75">Under 75 mph (senior/beginner)</option>
            <option value="85">75-85 mph (casual)</option>
            <option value="95">85-95 mph (average)</option>
            <option value="105">95-105 mph (above average)</option>
            <option value="115">105+ mph (fast)</option>
          </select>
        </div>
        <div>
          <label for="bf-budget" style="font-weight:600;font-size:16px;display:block;margin:0 0 6px;">Budget per dozen</label>
          <select id="bf-budget" style="width:100%;padding:10px;border:1px solid var(--border);border-radius: var(--r2);font-size:16px;">
            <option value="0">Any price</option>
            <option value="25">Under $25</option>
            <option value="35">Under $35</option>
            <option value="50">Under $50</option>
            <option value="60">Under $60</option>
          </select>
        </div>
        <div>
          <label for="bf-cover" style="font-weight:600;font-size:16px;display:block;margin:0 0 6px;">Cover type</label>
          <select id="bf-cover" style="width:100%;padding:10px;border:1px solid var(--border);border-radius: var(--r2);font-size:16px;">
            <option value="">Any</option>
            <option value="Urethane">Urethane (tour spin)</option>
            <option value="Ionomer">Ionomer (durable/value)</option>
          </select>
        </div>
        <div>
          <label for="bf-feel" style="font-weight:600;font-size:16px;display:block;margin:0 0 6px;">Preferred feel</label>
          <select id="bf-feel" style="width:100%;padding:10px;border:1px solid var(--border);border-radius: var(--r2);font-size:16px;">
            <option value="">Any feel</option>
            <option value="Soft">Soft</option>
            <option value="Mid">Mid</option>
            <option value="Firm">Firm</option>
          </select>
        </div>
      </div>
      <button id="bf-reset" type="button" style="margin:16px 0 0;padding:8px 16px;background:var(--gold);color:#1a1a1a;border:none;border-radius: var(--r1);font-weight:700;cursor:pointer;font-size:16px;">Reset Filters</button>
    </section>

    <!-- RESULTS TABLE (server-rendered, filterable via JS) -->
    <section>
      <h2 style="font-size:18px;color:var(--green);margin:0 0 12px;">Results <span id="bf-count" style="font-size:16px;color:var(--muted);" aria-live="polite">({balls.length} balls)</span></h2>
      <div style="overflow-x:auto;">
        <table id="bf-table" class="cmp-table" style="width:100%;">
          <thead>
            <tr>
              <th>Golf Ball</th>
              <th class="cmp-num">Compression</th>
              <th>Feel</th>
              <th>Cover</th>
              <th class="cmp-num">Price/dz</th>
              <th class="cmp-num">Speed Range</th>
              <th>Best For</th>
              <th>Buy</th>
            </tr>
          </thead>
          <tbody>
            {balls.map(b => (
              <tr data-comp={b.compression} data-cover={b.cover} data-feel={b.feel} data-price={b.price} data-min={b.minMph} data-max={b.maxMph}>
                <td style="font-weight:600;">{b.name}</td>
                <td class="cmp-num">{b.compression}</td>
                <td>{b.feel}</td>
                <td>{b.cover}</td>
                <td class="cmp-num">~${b.price}</td>
                <td class="cmp-num">{b.minMph}-{b.maxMph} mph</td>
                <td style="font-size:16px;color:var(--muted);">{b.bestFor}</td>
                <td style="white-space:nowrap;">
                  {(b as any).affiliateKey && BALL_URLS[(b as any).affiliateKey] ? (
                    <a href={BALL_URLS[(b as any).affiliateKey]} target="_blank"
                       rel="nofollow noopener sponsored"
                       style="background:var(--gold);color:#1a1a1a;font-size:15px;font-weight:700;padding:7px 13px;border-radius: var(--r1);text-decoration:none;">
                      Check Price →
                    </a>
                  ) : (
                    <span style="font-size:15px;color:var(--muted);">—</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- RELATED LINKS -->
    <section style="margin:32px 0 24px;padding:20px 24px;background:#fff;border:1px solid var(--border);border-radius: var(--r2);">
      <h2 style="font-size:16px;color:var(--green);margin:0 0 10px;">Related guides</h2>
      <ul style="font-size:16px;line-height:1.8;margin:0;padding:0 0 0 18px;">
        <li><a href="/golf-ball-compression-chart/">Golf Ball Compression Chart</a> — full data on all {CHART_BALL_COUNT} balls</li>
        <li><a href="/best-golf-balls-2026/">Best Golf Balls</a> — our tested picks by category</li>
        <li><a href="/golf-swing-speed-chart/">Golf Swing Speed Chart</a> — find your speed by club</li>
        <li><a href="/compare/titleist-pro-v1-vs-kirkland-signature/">Pro V1 vs Kirkland</a> — premium vs value head-to-head</li>
      </ul>
    </section>

    <!-- EMBED / SHARE -->
    <div class="art-note" style="margin:0 0 28px;padding:16px;background:rgba(30,58,40,.03);border-radius: var(--r2);">
      <p style="font-size:16px;font-weight:600;color:var(--green);margin:0 0 8px;">Share or embed this tool</p>
      <input type="text" readonly value='<iframe src="https://www.cubicalgolfer.com/golf-ball-finder/" width="100%" height="800" frameborder="0"></iframe>' style="width:100%;padding:8px;font-size:16px;border:1px solid var(--border);border-radius: var(--r1);color:var(--muted);" onclick="this.select();" />
      <p style="font-size:16px;color:var(--muted);margin:6px 0 0;">Click to copy. Free to embed with credit to Cubical Golfer.</p>
    </div>

    <!-- FAQ -->
    <section id="faq">
      <h2 style="font-size:18px;color:var(--green);margin:0 0 16px;">Frequently Asked Questions</h2>
      {faq.map(({ q, a }) => (
        <div style="margin:0 0 16px;">
          <h3 style="font-size:16px;margin:0 0 6px;">{q}</h3>
          <p style="font-size:16px;line-height:1.7;color:var(--body);margin:0;">{a}</p>
        </div>
      ))}
    </section>

    <section style="margin:40px 0 0;">
      <h2>Compare Your Top Picks</h2>
      <p>Found two balls that interest you? See how they stack up head-to-head:</p>
      <ul>
        <li><a href="/compare/vice-pro-vs-titleist-pro-v1/">Vice Pro vs Pro V1 — is the premium worth it?</a></li>
        <li><a href="/compare/callaway-supersoft-vs-srixon-soft-feel/">Supersoft vs Soft Feel — pick by swing speed</a></li>
        <li><a href="/compare/srixon-q-star-tour-vs-callaway-chrome-soft/">Q-Star Tour vs Chrome Soft — mid-price comparison</a></li>
      </ul>
    </section>
  </article>

  <script>
  (function(){
    var rows = document.querySelectorAll('#bf-table tbody tr');
    var countEl = document.getElementById('bf-count');
    function filter(){
      var speed = parseInt(document.getElementById('bf-speed').value) || 0;
      var budget = parseInt(document.getElementById('bf-budget').value) || 0;
      var cover = document.getElementById('bf-cover').value;
      var feel = document.getElementById('bf-feel').value;
      var visible = 0;
      rows.forEach(function(row){
        var min = parseInt(row.dataset.min);
        var max = parseInt(row.dataset.max);
        var rCover = row.dataset.cover;
        var rFeel = row.dataset.feel;
        var rPrice = parseInt(row.dataset.price);
        var show = true;
        if(speed > 0 && (speed < min || speed > max + 10)) show = false;
        if(budget > 0 && rPrice > budget) show = false;
        if(cover && rCover !== cover) show = false;
        if(feel && !rFeel.toLowerCase().includes(feel.toLowerCase())) show = false;
        row.style.display = show ? '' : 'none';
        if(show) visible++;
      });
      countEl.textContent = '(' + visible + ' balls)';
    }
    ['bf-speed','bf-budget','bf-cover','bf-feel'].forEach(function(id){
      document.getElementById(id).addEventListener('change', filter);
    });
    document.getElementById('bf-reset').addEventListener('click', function(){
      ['bf-speed','bf-budget','bf-cover','bf-feel'].forEach(function(id){ document.getElementById(id).selectedIndex = 0; });
      filter();
    });
  })();
  </script>
</BaseLayout>
