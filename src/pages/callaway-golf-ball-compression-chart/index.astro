---
// Callaway golf ball compression chart — Sprint 100.
// Targets the brand-qualified query cluster only. The unqualified head term
// stays with the all-brands chart (the site's biggest earner); rationale and
// the GSC evidence are documented in BrandCompressionChart.astro.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ROBOTS_INDEX } from '../../lib/seo';
import BrandCompressionChart from '../../components/BrandCompressionChart.astro';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';
import { brandFaqFacts, FULL_CHART_BLURB } from '../../data/ball-brands';

// Sprint 165: these three answers and the full-chart blurb are derived from
// balls.ts instead of typed. Typed by hand they undercounted the chart by a ball
// and a brand, and on Titleist they named the 70-compression TruFeel as its
// softest ball while the table two screens above showed two balls at 65.
const facts = brandFaqFacts('Callaway');

const meta = {
  title: "Callaway Golf Ball Compression Chart 2026 \u2014 All 4",
  description: "Compression, cover and price for all 4 Callaway golf balls, from the Supersoft (38) to the Chrome Tour (90), matched to your swing speed.",
  canonical: 'https://www.cubicalgolfer.com/callaway-golf-ball-compression-chart/',
  ogImage: 'https://www.cubicalgolfer.com/images/og/golf-ball-compression-chart.jpg',
  ogType: 'article' as const,
  robots: ROBOTS_INDEX,
  breadcrumbs: [
    { label: 'Home', href: '/' },
    { label: 'Compression Chart', href: '/golf-ball-compression-chart/' },
    { label: "Callaway Compression", href: "/callaway-golf-ball-compression-chart/" },
  ],
};

const faq = [
  { q: "What is the compression of Callaway golf balls?", a: facts.range },
  { q: "Which Callaway golf ball is the softest?", a: facts.softest },
  { q: "Which Callaway ball suits my swing speed?", a: "Match compression to driver speed. Under 85 mph suits the softer end of the Callaway range; 85-100 mph the middle; over 100 mph the firmest. The table above lists the rated speed range for every Callaway ball." },
  { q: "How many Callaway golf balls are on this chart?", a: facts.howMany },
];

const siblings = [{"brand": "Titleist", "slug": "/titleist-golf-ball-compression-chart/"}, {"brand": "TaylorMade", "slug": "/taylormade-golf-ball-compression-chart/"}, {"brand": "Srixon", "slug": "/srixon-golf-ball-compression-chart/"}, {"brand": "Bridgestone", "slug": "/bridgestone-golf-ball-compression-chart/"}, {"brand": "Vice", "slug": "/vice-golf-ball-compression-chart/"}];
const schemas = [breadcrumbSchema(meta.breadcrumbs), faqSchema(faq)];
---

<BaseLayout {meta} {schemas} activeNav="improve">
  <article class="art-content brand-chart-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">&#8250;</span>
      <a href="/golf-ball-compression-chart/">Compression Chart</a>
      <span aria-hidden="true">&#8250;</span>
      <span>Callaway</span>
    </nav>

    <h1>Callaway Golf Ball Compression Chart</h1>

    <BrandCompressionChart brand="Callaway" siblings={siblings} />

    <section class="brand-chart-cta">
      <p class="brand-chart-cta__lead">Want every brand in one table?</p>
      <p class="brand-chart-cta__blurb">{FULL_CHART_BLURB}</p>
      <a class="brand-chart-cta__btn" href="/golf-ball-compression-chart/">Open the full compression chart &#8594;</a>
    </section>

    <section>
      <h2 id="faq">Frequently Asked Questions</h2>
      {faq.map(f => (
        <div class="brand-chart-faq__item">
          <h3 class="brand-chart-faq__q">{f.q}</h3>
          <p class="brand-chart-faq__a">{f.a}</p>
        </div>
      ))}
    </section>
  </article>
</BaseLayout>
